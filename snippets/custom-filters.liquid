{{ "jisan rahman" }}
{{ 'custom-filter.css' | asset_url | stylesheet_tag }}

<form method="get" action="{{ collection.url }}" class="collection-filters">

<section class="section-2">

  {%- for filter in collection.filters -%}

    <div class="div-block">

      <!-- Filter Header -->
      <div class="div-block-2">
        <div class="text-block">{{ filter.label }}</div>
        <img
          src="{{ 'Vector.png' | asset_url }}"
          class="image-2"
          alt=""
          width="12"
          height="6"
        >
      </div>

      <div class="w-form">

        {%- for value in filter.values -%}

          {%- if forloop.index <= 2 -%}
            <!-- CHECKBOX -->
            <label class="w-radio">
              <input
                type="checkbox"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                {% if value.active %}checked{% endif %}
                onchange="this.form.submit()"
              >
              <span class="w-form-label">{{ value.label }}</span>
            </label>

          {%- else -%}
            <!-- BUTTON -->
            <a
              href="{{ value.url }}"
              class="button w-button {% if value.active %}is-active{% endif %}"
            >
              {{ value.label }}
            </a>
          {%- endif -%}

        {%- endfor -%}

      </div>

    </div>

  {%- endfor -%}

</section>

</form>


