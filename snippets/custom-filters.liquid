{{ "jisan rahman" }}
{{ 'custom-filter.css' | asset_url | stylesheet_tag }}

<form method="get" action="{{ collection.url }}" class="collection-filters">

<section class="section-2">

  {%- for filter in collection.filters -%}

    {%- unless filter.param_name contains 'price' or filter.param_name contains 'availability' -%}

      <div class="div-block">

        <!-- Filter Header -->
        <div class="div-block-2">
          <div class="text-block">
            {{ filter.label }}
          </div>
          <img
            src="{{ 'Vector.png' | asset_url }}"
            class="image-2"
            alt="vector image"
            width="12"
            height="6"
          >
        </div>

        <!-- Filter Values -->
        <div class="w-form">

          {%- if filter.type == 'list' -%}
            {%- for value in filter.values -%}
              <label class="w-radio">
                <input
                  type="button"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}checked{% endif %}
                  onchange="this.form.submit()"
                >
                <span class="w-form-label">
                  {{ value.label }}
                </span>
              </label>
            {%- endfor -%}
          {%- endif -%}

        </div>

      </div>

    {%- endunless -%}

  {%- endfor -%}

</section>

</form>

