<form method="get" action="{{ collection.url }}" class="collection-filters">

<section class="section-2">

  {%- for filter in collection.filters -%}

    <div class="div-block">

      <!-- FILTER HEADER -->
      <div class="div-block-2">
        <div class="text-block">
          {{ filter.label }}
        </div>
        
      </div>

      <!-- FILTER OPTIONS -->
      <div class="w-form">

        {%- case filter.type -%}

          {%- when 'list' -%}
            {%- for value in filter.values -%}
              <label class="w-radio">
                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}checked{% endif %}
                  onchange="this.form.submit()"
                >
                <span class="w-form-label">
                  {{ value.label }}
                  {% if value.count > 0 %}
                    ({{ value.count }})
                  {% endif %}
                </span>
              </label>
            {%- endfor -%}

          {%- when 'price_range' -%}
            <div class="form">
              <input
                type="number"
                name="{{ filter.min_value.param_name }}"
                value="{{ filter.min_value.value }}"
                placeholder="Min"
              >
              <input
                type="number"
                name="{{ filter.max_value.param_name }}"
                value="{{ filter.max_value.value }}"
                placeholder="Max"
              >
              <button type="submit" class="button w-button">
                Apply
              </button>
            </div>

        {%- endcase -%}

      </div>

    </div>

  {%- endfor -%}

</section>

</form>
