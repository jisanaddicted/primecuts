
{{ 'custom-filter.css' | asset_url | stylesheet_tag }}

<form method="get" action="{{ collection.url }}" class="collection-filters">
  <section class="section-2">

    {% assign filters = shop.metaobjects.filterdefination3.values %}

    {% for filter in filters %}
      <div class="div-block">
        <div class="div-block-2">
          <div class="text-block">{{ filter.title }}</div>
          <img src="{{ 'Vector.png' | asset_url }}" alt="Description of image" width="12" height="6">
        </div>
        
        

        {% if filter.ui_type.value.first == 'button' %}

          
          <div class="w-form">
            
            
            {% for value in filter.values.value %}
              
              <a
                href="{{ collection.url }}?filter.p.m.custom.{{ filter.handle }}={{ value | handle }}"
                class="button-prime w-button"
              >
                {{ value }}
              </a>
            {% endfor %}

          </div>
        {% endif %}

      </div>
    {% endfor %}

  </section>
</form>
